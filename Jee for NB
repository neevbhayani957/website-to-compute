const mongoose = require('mongoose');

const ownerSchema = new mongoose.Schema({
  _id: { type: String, default: 'owner' },
  password: { type: String, required: true }
});

module.exports = mongoose.model('Owner', ownerSchema);
const jwt = require('jsonwebtoken');

function authMiddleware(req, res, next) {
  const token = req.headers['authorization'];
  if (!token) return res.status(401).json({ message: 'No token' });

  jwt.verify(token, process.env.JWT_SECRET, (err, decoded) => {
    if (err) return res.status(403).json({ message: 'Invalid token' });
    req.user = decoded;
    next();
  });
}

module.exports = { authMiddleware };
const express = require('express');
const bcrypt = require('bcrypt');
const jwt = require('jsonwebtoken');
const Owner = require('../models/Owner');
const { authMiddleware } = require('../middleware/auth');
const router = express.Router();

// login
router.post('/login', async (req, res) => {
  const { password } = req.body;
  const owner = await Owner.findById('owner');

  if (!owner) return res.status(500).json({ message: 'Owner not setup' });

  const match = await bcrypt.compare(password, owner.password);
  if (!match) return res.status(401).json({ message: 'Wrong password' });

  const token = jwt.sign({ role: 'owner' }, process.env.JWT_SECRET, { expiresIn: '1h' });
  res.json({ token });
});

// reset password
router.post('/reset-password', authMiddleware, async (req, res) => {
  const { oldPassword, newPassword } = req.body;
  const owner = await Owner.findById('owner');

  const match = await bcrypt.compare(oldPassword, owner.password);
  if (!match) return res.status(400).json({ message: 'Old password incorrect' });

  const hashed = await bcrypt.hash(newPassword, 10);
  owner.password = hashed;
  await owner.save();

  process.env.JWT_SECRET = Math.random().toString(36).slice(2);

  res.json({ message: 'Password updated. All users logged out.' });
});

module.exports = router;
const express = require('express');
const multer = require('multer');
const path = require('path');
const { Storage } = require('@google-cloud/storage');
const { authMiddleware } = require('../middleware/auth');
const router = express.Router();

// in-memory storage
const upload = multer({ storage: multer.memoryStorage() });

// init GCS
const storage = new Storage({
  keyFilename: path.join(__dirname, '..', 'gcs-key.json'),
  projectId: process.env.GCP_PROJECT_ID
});
const bucket = storage.bucket(process.env.GCS_BUCKET);

// upload
router.post('/upload', authMiddleware, upload.single('file'), async (req, res) => {
  const blob = bucket.file(Date.now() + '-' + req.file.originalname);
  const stream = blob.createWriteStream({ resumable: false });

  stream.on('error', (err) => res.status(500).json({ message: err.message }));
  stream.on('finish', () => res.json({ message: 'Uploaded' }));
  stream.end(req.file.buffer);
});

// view file (inline)
router.get('/view/:filename', authMiddleware, (req, res) => {
  const remoteFile = bucket.file(req.params.filename);
  res.setHeader('Content-Disposition', 'inline');
  remoteFile.createReadStream().pipe(res);
});

// stream video
router.get('/stream/:filename', authMiddleware, async (req, res) => {
  const remoteFile = bucket.file(req.params.filename);
  const range = req.headers.range;
  if (!range) return res.status(400).send("Range required");

  const [metadata] = await remoteFile.getMetadata();
  const videoSize = parseInt(metadata.size, 10);

  const CHUNK_SIZE = 10 ** 6;
  const start = Number(range.replace(/\D/g, ""));
  const end = Math.min(start + CHUNK_SIZE, videoSize - 1);
  const contentLength = end - start + 1;

  res.writeHead(206, {
    "Content-Range": `bytes ${start}-${end}/${videoSize}`,
    "Accept-Ranges": "bytes",
    "Content-Length": contentLength,
    "Content-Type": metadata.contentType,
    "Content-Disposition": "inline"
  });

  remoteFile.createReadStream({ start, end }).pipe(res);
});

module.exports = router;
const express = require('express');
const mongoose = require('mongoose');
const dotenv = require('dotenv');
const bcrypt = require('bcrypt');
const Owner = require('./models/Owner');

dotenv.config();
const app = express();

app.use(express.json());
app.use(express.static('public'));

// routes
app.use('/api/auth', require('./routes/auth'));
app.use('/api/files', require('./routes/files'));

// db connect
mongoose.connect(process.env.MONGO_URI).then(async () => {
  console.log("MongoDB Connected");

  // setup default owner password if not exists
  let owner = await Owner.findById('owner');
  if (!owner) {
    const hashed = await bcrypt.hash('admin123', 10);
    owner = new Owner({ _id: 'owner', password: hashed });
    await owner.save();
    console.log("Default password = admin123");
  }
});

app.listen(process.env.PORT, () => {
  console.log("Server running on port " + process.env.PORT);
});
